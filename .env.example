# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# `.env*` files are git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Resend API key. Server-side only.
# Create at https://resend.com/api-keys  (Resend dashboard -> API Keys)
# This is a SECRET. Never prefix it with NEXT_PUBLIC_ and never expose it to
# the browser: the delivery code runs in src/lib/resend.ts, which is imported
# only by the /api/enquiry route handler.
RESEND_API_KEY=

# The sender address. Must be on a domain you have verified in Resend
# (Resend dashboard -> Domains). For testing, Resend provides an onboarding
# sender address you can use without verifying a domain.
# Do not leave this blank and do not guess a value: the endpoint returns 503
# and enquiries are not delivered if it is missing.
RESEND_FROM_EMAIL=

# Where enquiries are delivered. This is the studio inbox that should be
# alerted. Blank means enquiries are silently lost, so it is required.
RESEND_TO_EMAIL=

# ---------------------------------------------------------------------------
# Admin sign-in
# ---------------------------------------------------------------------------
# Without these three values the /admin panel is locked (the guard fails
# closed) and /api/admin/auth replies 503. Generate the two secret values with:
#   npm run hash:admin-password -- "your password"
# which prints a ready-to-paste ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET.

# The single admin login address.
ADMIN_EMAIL=

# scrypt hash of the password — never the password itself. Generated by the
# command above. It is verified in src/lib/adminAuth.ts.
ADMIN_PASSWORD_HASH=

# Random 32-byte hex key used to HMAC-sign the session cookie. Rotating this
# signs everyone out. Generated by the command above.
ADMIN_SESSION_SECRET=
